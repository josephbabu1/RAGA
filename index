<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Swara</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #11122a;
    --card: #1b1c3a;
    --node: #12132b;
    --line: #2a2c55;
    --text: #eceefb;
    --muted: #8a8db5;
    --accent: #ffc13b;
    --accent-ink: #1a1400;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; background: var(--bg); color: var(--text);
    font-family: Inter, system-ui, sans-serif; }
  main { max-width: 440px; margin: 0 auto; padding: 28px 18px 48px; }
  h1 { font-family: Fraunces, Georgia, serif; font-size: 40px; margin: 0 0 6px; }
  .sub { color: var(--muted); margin: 0 0 22px; line-height: 1.45; }
  .card { background: var(--card); border: 1px solid var(--line);
    border-radius: 22px; padding: 20px; margin-bottom: 16px; }

  /* wheel */
  .wheel { position: relative; }
  .wheel svg { width: 100%; height: auto; display: block; }
  .ring { fill: none; stroke: var(--line); stroke-width: 1; }
  .inner { fill: none; stroke: var(--line); stroke-width: 1; stroke-dasharray: 1 5; }
  .node circle { fill: var(--node); stroke: var(--line); }
  .node text { fill: var(--muted); font-size: 11px; text-anchor: middle;
    dominant-baseline: central; font-family: Inter, sans-serif; }
  .node.on circle { fill: var(--accent); stroke: var(--accent); }
  .node.on text { fill: var(--accent-ink); font-weight: 600; }
  #pointer { transition: opacity .2s; opacity: 0; }
  #pointer circle { fill: var(--accent); opacity: .9; }
  .center { position: absolute; inset: 0; display: flex; flex-direction: column;
    align-items: center; justify-content: center; pointer-events: none; gap: 2px; }
  #name { font-family: Fraunces, Georgia, serif; font-size: 34px; font-weight: 700;
    color: var(--muted); transition: color .15s; }
  #name.live { color: var(--text); }
  #hz { font-size: 13px; color: var(--muted); min-height: 16px; }
  #oct { font-size: 12px; color: var(--muted); min-height: 14px; }

  /* sa panel */
  .label-row { display: flex; justify-content: space-between; color: var(--muted); font-size: 14px; }
  #saHz { font-family: Fraunces, Georgia, serif; font-size: 44px; font-weight: 700; margin: 6px 0 14px; }
  #status { line-height: 1.45; margin: 0 0 14px; min-height: 44px; }
  .bar { height: 6px; background: var(--node); border-radius: 3px; overflow: hidden;
    margin-bottom: 14px; opacity: 0; transition: opacity .2s; }
  .bar.show { opacity: 1; }
  #prog { height: 100%; width: 0; background: var(--accent); }
  .row { display: flex; gap: 10px; margin-bottom: 14px; }
  button { font: inherit; font-weight: 600; border-radius: 12px; padding: 11px 18px;
    cursor: pointer; border: 1px solid var(--line); background: transparent; color: var(--text); }
  button.primary { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
  button:focus-visible, select:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  button:disabled { opacity: .4; cursor: default; }
  .input-row { display: flex; align-items: center; gap: 10px; color: var(--muted); font-size: 14px; }
  select { flex: 1; min-width: 0; background: var(--node); color: var(--text);
    border: 1px solid var(--line); border-radius: 10px; padding: 11px 12px; font: inherit; }

  /* tuning */
  .card h2 { font-size: 16px; margin: 0 0 16px; font-weight: 600; }
  .meter { position: relative; height: 4px; background: var(--line); border-radius: 2px; }
  #needle { position: absolute; top: -8px; left: 50%; width: 2px; height: 20px;
    background: var(--muted); transform: translateX(-50%); transition: left .08s linear, background .1s; }
  #needle.ok { background: #5de0a6; }
  .meter-labels { display: flex; justify-content: space-between; color: var(--muted);
    font-size: 13px; margin-top: 12px; }

  /* history */
  #hist { display: flex; flex-wrap: wrap; gap: 8px; min-height: 52px; }
  .chip { position: relative; padding: 8px 14px; border-radius: 999px; border: 1px solid var(--line);
    background: var(--node); font-family: Fraunces, Georgia, serif; font-weight: 600; }
  .chip.latest { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
  .chip i { position: absolute; left: 50%; width: 4px; height: 4px; border-radius: 50%;
    background: currentColor; transform: translateX(-50%); }
  .chip i.up { top: 3px; }
  .chip i.down { bottom: 3px; }
  .empty { color: var(--muted); font-size: 14px; }
  @media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
</style>
</head>
<body>
<main>
  <h1>Swara</h1>
  <p class="sub">Sing a note and see which swara you are on, measured from your own Sa.</p>

  <section class="card wheel" aria-label="Swara wheel">
    <svg id="wheel" viewBox="0 0 300 300" role="img" aria-label="Twelve swara positions around a circle">
      <circle class="ring" cx="150" cy="150" r="112"/>
      <circle class="inner" cx="150" cy="150" r="82"/>
      <g id="pointer"><circle cx="150" cy="38" r="5"/></g>
      <g id="nodes"></g>
    </svg>
    <div class="center">
      <div id="name">Sa</div>
      <div id="oct"></div>
      <div id="hz"></div>
    </div>
  </section>

  <section class="card" aria-label="Sa">
    <div class="label-row"><span>Your Sa</span><span id="saCents">Sa = 0 cents</span></div>
    <div id="saHz">&mdash;</div>
    <p id="status">Start the microphone to begin.</p>
    <div class="bar" id="bar"><div id="prog"></div></div>
    <div class="row">
      <button class="primary" id="main">Start microphone</button>
      <button id="stop" disabled>Stop</button>
    </div>
    <div class="input-row">
      <label for="input">Input</label>
      <select id="input"><option value="">Default</option></select>
    </div>
  </section>

  <section class="card" aria-label="Tuning">
    <h2>Tuning</h2>
    <div class="meter"><div id="needle"></div></div>
    <div class="meter-labels"><span>flat</span><span>sharp</span></div>
  </section>

  <section class="card" aria-label="Recent swaras">
    <h2>Recent swaras</h2>
    <div id="hist"><span class="empty">Held notes will appear here.</span></div>
  </section>
</main>

<script>
(function () {
  "use strict";

  /* ---------- constants ---------- */
  const NAMES = ["Sa","Ri1","Ri2/Ga1","Ga2/Ri3","Ga3","Ma1","Ma2","Pa","Da1","Da2/Ni1","Ni2/Da3","Ni3"];
  const SHORT = ["Sa","Ri1","Ri2","Ga2","Ga3","Ma1","Ma2","Pa","Da1","Da2","Ni2","Ni3"];
  const STABILITY = 3;          // consecutive identical readings to confirm
  const FRAME_MS = 46;          // analysis interval (about one 2048-sample block at 44.1 kHz)
  const HISTORY = 6;
  const $ = (id) => document.getElementById(id);

  /* ---------- state ---------- */
  let mode = "idle";            // idle | ready | countdown | capturing | tracking
  let ctx = null, analyser = null, stream = null, buf = null, raf = 0;
  let sa = null, phaseEnd = 0, samples = [], lastRun = 0;
  let recent = [], lastShown = null, history = [];
  let angle = 0, targetAngle = 0;

  /* ---------- wheel ---------- */
  const nodes = [];
  (function buildWheel() {
    const g = $("nodes"), NS = "http://www.w3.org/2000/svg";
    for (let k = 0; k < 12; k++) {
      const a = (-90 + k * 30) * Math.PI / 180;
      const x = 150 + 112 * Math.cos(a), y = 150 + 112 * Math.sin(a);
      const n = document.createElementNS(NS, "g");
      n.setAttribute("class", "node");
      const c = document.createElementNS(NS, "circle");
      c.setAttribute("cx", x); c.setAttribute("cy", y); c.setAttribute("r", 17);
      const t = document.createElementNS(NS, "text");
      t.setAttribute("x", x); t.setAttribute("y", y);
      t.textContent = SHORT[k];
      n.appendChild(c); n.appendChild(t); g.appendChild(n); nodes.push(n);
    }
  })();

  function animate() {
    let d = ((targetAngle - angle + 540) % 360) - 180;   // shortest way round
    angle = (angle + d * 0.25 + 360) % 360;
    $("pointer").setAttribute("transform", "rotate(" + angle.toFixed(2) + " 150 150)");
    requestAnimationFrame(animate);
  }
  requestAnimationFrame(animate);

  /* ---------- YIN pitch detection ---------- */
  function detect(b, sr) {
    let peak = 0;
    for (let i = 0; i < b.length; i++) { const v = Math.abs(b[i]); if (v > peak) peak = v; }
    if (peak < 0.01) return null;

    const W = 1536,
          maxTau = Math.min(Math.floor(sr / 60), b.length - W - 1),
          minTau = Math.max(2, Math.floor(sr / 1000));
    const cm = new Float32Array(maxTau + 1); cm[0] = 1; let run = 0;

    for (let t = 1; t <= maxTau; t++) {
      let s = 0;
      for (let j = 0; j < W; j++) { const d = b[j] - b[j + t]; s += d * d; }
      run += s; cm[t] = s * t / (run || 1);
    }
    for (let t = minTau; t <= maxTau; t++) {
      if (cm[t] < 0.15) {
        while (t + 1 <= maxTau && cm[t + 1] < cm[t]) t++;
        const a = cm[t - 1], c = cm[t + 1] ?? cm[t], m = cm[t],
              den = a + c - 2 * m;
        const tau = den ? t + (a - c) / (2 * den) : t;
        const f = sr / tau;
        return (f >= 60 && f <= 1000) ? f : null;
      }
    }
    return null;
  }

  function median(a) {
    const s = a.slice().sort((x, y) => x - y), m = s.length >> 1;
    return s.length % 2 ? s[m] : (s[m - 1] + s[m]) / 2;
  }

  /* ---------- UI helpers ---------- */
  function setStatus(t) { $("status").textContent = t; }

  function setMode(m) {
    mode = m;
    const main = $("main");
    $("bar").classList.toggle("show", m === "countdown" || m === "capturing");
    $("stop").disabled = (m === "idle");
    if (m === "idle") main.textContent = "Start microphone";
    if (m === "ready") main.textContent = "Set Sa";
    if (m === "countdown" || m === "capturing") main.textContent = "Setting Sa...";
    if (m === "tracking") main.textContent = "Reset Sa";
    main.disabled = (m === "countdown" || m === "capturing");
  }

  function clearLive() {
    recent = []; lastShown = null;
    nodes.forEach((n) => n.classList.remove("on"));
    $("pointer").style.opacity = 0;
    $("hz").textContent = ""; $("oct").textContent = "";
    $("name").classList.remove("live");
    $("needle").style.left = "50%"; $("needle").classList.remove("ok");
  }

  function renderHistory() {
    const h = $("hist");
    h.innerHTML = "";
    if (!history.length) { h.innerHTML = '<span class="empty">Held notes will appear here.</span>'; return; }
    history.forEach((e, i) => {
      const c = document.createElement("span");
      c.className = "chip" + (i === 0 ? " latest" : "");
      c.textContent = SHORT[e.sw];
      if (e.oct !== 0) {
        const d = document.createElement("i");
        d.className = e.oct > 0 ? "up" : "down";
        c.appendChild(d);
      }
      h.appendChild(c);
    });
  }

  /* ---------- microphone ---------- */
  async function listInputs() {
    const sel = $("input"), cur = sel.value;
    const devs = (await navigator.mediaDevices.enumerateDevices()).filter((d) => d.kind === "audioinput");
    sel.innerHTML = '<option value="">Default</option>';
    devs.forEach((d, i) => {
      const o = document.createElement("option");
      o.value = d.deviceId; o.textContent = d.label || "Microphone " + (i + 1);
      sel.appendChild(o);
    });
    sel.value = cur;
  }

  function closeAudio() {
    cancelAnimationFrame(raf);
    if (stream) stream.getTracks().forEach((t) => t.stop());
    if (ctx) ctx.close();
    stream = ctx = analyser = null;
  }

  async function openMic() {
    closeAudio();
    const id = $("input").value;
    stream = await navigator.mediaDevices.getUserMedia({
      audio: {
        deviceId: id ? { exact: id } : undefined,
        echoCancellation: false, noiseSuppression: false, autoGainControl: false
      }
    });
    ctx = new (window.AudioContext || window.webkitAudioContext)();
    const src = ctx.createMediaStreamSource(stream);
    analyser = ctx.createAnalyser();
    analyser.fftSize = 4096;
    buf = new Float32Array(analyser.fftSize);
    src.connect(analyser);
    await listInputs();
    raf = requestAnimationFrame(tick);
  }

  /* ---------- main loop ---------- */
  function tick(now) {
    raf = requestAnimationFrame(tick);
    if (now - lastRun < FRAME_MS) return;
    lastRun = now;

    analyser.getFloatTimeDomainData(buf);
    const f = detect(buf, ctx.sampleRate);

    if (mode === "countdown") {
      const left = Math.max(0, phaseEnd - now);
      $("prog").style.width = "0%";
      setStatus("Get ready. Recording in " + Math.ceil(left / 1000) + "...");
      if (left <= 0) { phaseEnd = now + 3000; samples = []; setMode("capturing"); }
      return;
    }

    if (mode === "capturing") {
      if (f) samples.push(f);
      const p = Math.min(1, 1 - (phaseEnd - now) / 3000);
      $("prog").style.width = (p * 100).toFixed(0) + "%";
      setStatus("Sing and hold your Sa steady.");
      if (now >= phaseEnd) {
        if (samples.length < 15) {
          setMode("ready");
          setStatus("Couldn't hear a steady pitch. Sing louder and hold one note.");
          return;
        }
        sa = median(samples);
        $("saHz").textContent = sa.toFixed(1) + " Hz";
        setStatus("Sing freely. A swara appears once you hold a note steady.");
        clearLive();
        setMode("tracking");
      }
      return;
    }

    if (mode !== "tracking") return;

    if (!f) {                       // silence or no pitch
      recent = [];
      $("pointer").style.opacity = 0;
      $("name").classList.remove("live");
      $("hz").textContent = ""; $("oct").textContent = "";
      return;
    }

    const n = 12 * Math.log2(f / sa),
          r = Math.round(n),
          sw = ((r % 12) + 12) % 12,
          oct = Math.floor(r / 12),
          cents = (n - r) * 100;

    targetAngle = ((((n % 12) + 12) % 12) * 30);
    $("pointer").style.opacity = 1;
    $("hz").textContent = f.toFixed(1) + " Hz";

    const needle = $("needle");
    needle.style.left = (50 + Math.max(-50, Math.min(50, cents))) + "%";
    needle.classList.toggle("ok", Math.abs(cents) < 10);

    recent.push(sw + "|" + oct);
    if (recent.length > STABILITY) recent.shift();

    if (recent.length === STABILITY && new Set(recent).size === 1) {
      nodes.forEach((g, i) => g.classList.toggle("on", i === sw));
      $("name").textContent = NAMES[sw];
      $("name").classList.add("live");
      $("oct").textContent = oct <= -1 ? "mandra" : oct === 0 ? "madhya" : "tara";
      if (recent[0] !== lastShown) {
        lastShown = recent[0];
        history.unshift({ sw, oct });
        if (history.length > HISTORY) history.pop();
        renderHistory();
      }
    }
  }

  /* ---------- controls ---------- */
  $("main").addEventListener("click", async () => {
    try {
      if (mode === "idle") {
        await openMic();
        setMode("ready");
        setStatus("Press Set Sa, then hold your tonic for 3 seconds.");
      } else if (mode === "ready" || mode === "tracking") {
        clearLive();
        phaseEnd = performance.now() + 2000;
        setMode("countdown");
      }
    } catch (e) {
      setStatus("Microphone unavailable. Allow access and open this page via localhost or https.");
      setMode("idle");
    }
  });

  $("stop").addEventListener("click", () => {
    closeAudio(); clearLive();
    sa = null; $("saHz").innerHTML = "&mdash;";
    setMode("idle");
    setStatus("Start the microphone to begin.");
  });

  $("input").addEventListener("change", async () => {
    if (mode === "idle") return;
    try { await openMic(); } catch (e) { setStatus("Could not switch microphone."); }
  });

  setMode("idle");
})();
</script>
</body>
</html>
